{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@starye/quant-contracts": ["../../packages/quant-contracts/dist/index.d.ts"],
      "@starye/*": ["../../packages/*/src"]
    },
    "types": ["@cloudflare/workers-types", "node"],
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist"
  },
  "references": [
    { "path": "../../packages/config" },
    { "path": "../../packages/db" },
    { "path": "../../packages/quant-contracts" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.ts"]
}
